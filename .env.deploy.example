# Settings for scripts/deploy-smarterasp.php.
# Copy to .env.deploy (gitignored) and fill in DEPLOY_FTP_PASSWORD.

# FTP account from the SmarterASP control panel (explicit FTPS, port 21).
DEPLOY_FTP_HOST=win9060.site4now.net
DEPLOY_FTP_USER=duaraacademy-001
DEPLOY_FTP_PASSWORD=

# Site folder relative to the FTP root, and the public URL of that site.
DEPLOY_FTP_PATH=/site1
DEPLOY_URL=https://duaraacademy-001-site1.itempurl.com

# Production .env shipped to the server as .env (keep it out of git).
DEPLOY_ENV_FILE=.env.production
